# meraat.piqagram.ir - نمونه فایل .env برای سرور
#
# این فایل را روی سرور به .env کپی کن و مقادیر را پر کن:
#   cp .env.production.example .env
#
# مهم: اگر سایت فعلی سرور از قبل .env دارد، همان را کپی کن و فقط DB_HOST و
# بخش «docker compose» پایین را عوض کن. با ست کردن APP_KEY جدید
# (php artisan key:generate) همه نشست‌ها باطل می‌شوند و هر مقداری که با کلید
# قبلی رمزنگاری شده باشد دیگر خوانده نمی‌شود.
#
# این فایل هم توسط Laravel خوانده می‌شود و هم به عنوان env file خود compose.

# ---- Laravel ---------------------------------------------------------------

APP_NAME=meraat
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://meraat.piqagram.ir

LOG_CHANNEL=stack

# داخل شبکه compose نام سرویس دیتابیس «db» است، نه 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=inbox
DB_USERNAME=meraat_user
DB_PASSWORD=CHANGE_ME

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=meraat

# ---- docker compose --------------------------------------------------------

# nginx کانتینر روی این آدرس منتشر می‌شود. پیش‌فرض فقط loopback است تا nginx
# خود سرور (که SSL را تمام می‌کند) پشت آن قرار بگیرد. اگر می‌خواهی کانتینر
# مستقیم روی اینترنت باشد، WEB_BIND=0.0.0.0 و WEB_PORT=80 بگذار و
# BACKEND_HTTPS را off کن (مگر اینکه خودت TLS را داخل کانتینر بدهی).
WEB_BIND=127.0.0.1
WEB_PORT=8080

# server_name در vhost کانتینر
SERVER_NAME=meraat.piqagram.ir

# چون TLS روی nginx سرور تمام می‌شود، به PHP می‌گوییم درخواست https است تا
# آدرس‌های asset()/url() هم https ساخته شوند.
BACKEND_HTTPS=on

# رمز روت مارینا؛ برای بکاپ/بازگردانی دستی و healthcheck لازم است.
DB_ROOT_PASSWORD=CHANGE_ME_ROOT
