# meraat.piqagram.ir - production image (Laravel 5.6 on PHP 7.4 FPM)
#
# Unlike the development Dockerfile this one bakes the application code into
# the image, so the server never bind-mounts the working tree. That means:
#
#   * a deploy is a rebuild -> the running code is exactly what was built
#   * OPcache with validate_timestamps=0 is safe (files never change under it)
#   * no Windows/Unix path or permission surprises from a mounted tree
#
# vendor/ is intentionally NOT copied in (see .dockerignore): it is resolved
# here with `composer install` so it always matches composer.lock.
FROM php:7.4-fpm

# How many translation units to compile in parallel. The deployment host is
# shared and has four cores but under 1 GB of spare memory and no swap, so the
# build is pinned low there (BUILD_JOBS=1). Empty = use every core.
ARG BUILD_JOBS=

# Which Debian mirror to pull the build dependencies from. bullseye is an
# archived release, so archive.debian.org is the canonical source - but this
# host measures about 0.6 KB/s against it, which turns an 11 MB package index
# into a multi-hour download. Both mirrors are therefore build args, forwarded
# from .env by docker-compose.prod.yml:
#
#   DEBIAN_MIRROR          empty -> archive.debian.org (the dev default)
#   DEBIAN_SECURITY_MIRROR empty -> no security suite at all
#
# Dropping the security suite is deliberate and safe here: every package
# installed below (the GD/libzip/libonig headers, unzip and mariadb-client)
# lives in main.
ARG DEBIAN_MIRROR=
ARG DEBIAN_SECURITY_MIRROR=

# php:7.4-fpm is built on Debian bullseye. Check-Valid-Until has to be disabled
# because the archive's Release files are expired by design.
RUN set -eux; \
    main="${DEBIAN_MIRROR:-http://archive.debian.org/debian}"; \
    sec="${DEBIAN_SECURITY_MIRROR-http://archive.debian.org/debian-security}"; \
    printf 'deb %s bullseye main\n' "$main" > /etc/apt/sources.list; \
    if [ -n "$sec" ]; then \
        printf 'deb %s bullseye-security main\n' "$sec" >> /etc/apt/sources.list; \
    fi; \
    cat /etc/apt/sources.list; \
    printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "3";\n' > /etc/apt/apt.conf.d/99debian-archive; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        libpng-dev libjpeg62-turbo-dev libfreetype6-dev libzip-dev libonig-dev unzip mariadb-client; \
    docker-php-ext-configure gd --with-freetype --with-jpeg; \
    docker-php-ext-install -j"${BUILD_JOBS:-$(nproc)}" pdo_mysql mbstring exif gd zip bcmath opcache; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# composer is used at build time to produce vendor/.
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY docker/php/app.ini /usr/local/etc/php/conf.d/zz-app.ini
COPY docker/php/fpm-pool-prod.conf /usr/local/etc/php-fpm.d/zz-pool.conf

WORKDIR /var/www/html

# Dependencies first: a code-only change then reuses this (slow) layer.
COPY composer.json composer.lock ./

# The root package lists database/seeds and database/factories as classmap
# paths, and composer scans those while it generates the autoloader - so they
# have to exist before install runs, not just before the code is copied.
COPY database/ ./database/
RUN composer install \
        --no-dev --no-interaction --no-progress --prefer-dist \
        --optimize-autoloader --no-scripts

# Application code. vendor/ is excluded by .dockerignore, so this layer cannot
# overwrite the dependencies resolved above.
COPY . .

# Now that artisan and the whole tree are present, finish the autoloader and
# let Laravel discover its packages. --no-scripts above was needed because
# package:discover requires the application code.
RUN composer dump-autoload --no-dev --optimize \
 && php artisan package:discover --ansi \
 && mkdir -p \
        storage/app/backups \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
 && chown -R www-data:www-data storage bootstrap/cache

# The code is immutable at runtime, so `config:cache` could be baked in here
# for a small win - except that it would freeze the values of this machine's
# .env into the image. config/ is left uncached and read from the mounted
# .env on every boot instead.
COPY docker/entrypoint.prod.sh /usr/local/bin/meraat-entrypoint
RUN chmod +x /usr/local/bin/meraat-entrypoint

EXPOSE 9000

ENTRYPOINT ["meraat-entrypoint"]
CMD ["php-fpm"]
