APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# کلید ایجنتِ شبکهٔ محل کار برای API اپ موبایل (POST /api/v1/office-ip).
# خالی بماند یعنی قید شبکه خاموش است.
MOBILE_OFFICE_AGENT_KEY=

# --- تازه‌سازیِ زندهٔ پنل (هابِ WebSocket، پوشهٔ ws/) -----------------------------
# کلیدِ مشترک بین PHP و هاب. خالی بماند یعنی مسیرِ زنده خاموش است و پنل با
# همان درخواست‌های دوره‌ای کار می‌کند (کند ولی سالم). اگر پر شد، یک مقدارِ
# تصادفیِ بلند بگذار، مثلاً:
#     php -r "echo bin2hex(random_bytes(24));"
HUB_SECRET=

# پورتِ میزبانیِ هاب روی loopback (nginx خودِ سرور به همین می‌رود). اگر پورتِ
# آزاد نیست، همین‌جا و در deploy/host-nginx-meraat.conf هر دو را عوض کن.
WS_PORT=8091
