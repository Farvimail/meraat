APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# کلید ایجنتِ شبکهٔ محل کار برای API اپ موبایل (POST /api/v1/office-ip).
# خالی بماند یعنی قید شبکه خاموش است.
MOBILE_OFFICE_AGENT_KEY=

# کلیدِ امضای کدِ QR تأیید حضور. خالی = کل مسیر خاموش (نه QR ای ساخته می‌شود
# و نه تأییدی لازم است). مقداردهی:
#     php -r "echo bin2hex(random_bytes(24));"
MOBILE_QR_KEY=

# آیا تأییدِ حضور با QR اجباری باشد؟ true یعنی «اول تأیید، بعد ثبت»: تا کارمند
# QR کارتِ خودش را اسکن نکند (یا مدیر دستی تأییدش نکند) ثبتِ ورود و خروجش
# انجام نمی‌شود. false یعنی فقط نمایش و تأییدِ دستیِ مدیر (راهِ فرار برای
# دوربینِ خراب) و هیچ ثبتی قفل نمی‌شود.
MOBILE_QR_REQUIRED=true

# (کدِ QR دیگر چرخان نیست: هر کارمند یک کدِ ثابتِ مخصوصِ خودش دارد.
# گزینهٔ MOBILE_QR_WINDOW که چرخشِ کد را تنظیم می‌کرد برداشته شد.)
#
# چند ثانیه بعد از اسکن، تأیید معتبر بماند؟ پیش‌فرض ۳۰ ثانیه. بعد از پایانِ
# این مهلت، ثبتِ بعدی (ورود یا خروج) دوباره یک اسکن می‌خواهد — وگرنه یک اسکن
# صبح تا شب درِ ثبت را باز می‌گذاشت. `0` یعنی بدونِ انقضا.

# --- فایلِ نصبیِ اپ (صفحهٔ /app) ------------------------------------------
# مسیرِ فایلِ APK، همان‌طور که از داخلِ کانتینرِ app دیده می‌شود. در استکِ
# داکر پوشهٔ بیرونیِ MOBILE_APK_DIR روی همین مسیر بایند می‌شود تا با هر بار
# فرستادنِ کد، فایلِ نصبی پاک نشود.
MOBILE_APK_PATH=/var/www/html/public/apk/Meraat.apk

# پوشهٔ فایلِ نصبی روی خودِ سرور (در docker-compose.prod.yml).
MOBILE_APK_DIR=/var/www/meraat-apk

# نسخه‌ای که در صفحهٔ دانلود نوشته می‌شود (همان نسخهٔ mobile/app.json).
MOBILE_APP_VERSION=1.1.0

# اختیاری: اگر فایل نصبی روی هاستِ دیگری است، همین نشانی در دکمه و QRِ صفحهٔ
# /app می‌نشیند و مسیرِ /app/download هم به همان‌جا می‌فرستد. خالی یعنی فایلِ
# روی خودِ سرور (MOBILE_APK_PATH).
MOBILE_APP_DOWNLOAD_URL=

# --- تازه‌سازیِ زندهٔ پنل (هابِ WebSocket، پوشهٔ ws/) -----------------------------
# کلیدِ مشترک بین PHP و هاب. خالی بماند یعنی مسیرِ زنده خاموش است و پنل با
# همان درخواست‌های دوره‌ای کار می‌کند (کند ولی سالم). اگر پر شد، یک مقدارِ
# تصادفیِ بلند بگذار، مثلاً:
#     php -r "echo bin2hex(random_bytes(24));"
HUB_SECRET=

# پورتِ میزبانیِ هاب روی loopback (nginx خودِ سرور به همین می‌رود). اگر پورتِ
# آزاد نیست، همین‌جا و در deploy/host-nginx-meraat.conf هر دو را عوض کن.
WS_PORT=8091
